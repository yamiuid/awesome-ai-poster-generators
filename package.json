{
  "name": "text-to-poster",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "sharp": "0.34.5"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "@img/sharp-linux-x64",
      "@img/sharp-win32-x64"
    ]
  },
  "overrides": {
    "sharp": "0.34.5"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check . && tsc --noEmit",
    "format": "biome format --write .",
    "migrate:r2": "node scripts/migrate-posters-to-r2.mjs",
    "migrate:r2:dry-run": "node scripts/migrate-posters-to-r2.mjs --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@img/sharp-libvips-linux-x64": "1.2.4",
    "@img/sharp-linux-x64": "0.34.5",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "@waffo/pancake-ts": "0.16.1",
    "cheerio": "^1.2.0",
    "ky": "2.0.2",
    "lucide-react": "1.28.0",
    "next": "16.2.12",
    "next-intl": "^4.14.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.34.5",
    "undici": "8.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react-doctor": "0.9.3",
    "react-grab": "0.1.50",
    "react-scan": "0.5.7",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
