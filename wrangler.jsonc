{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "text-to-poster",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "texttoposter.com/*",
      "zone_name": "texttoposter.com"
    },
    {
      "pattern": "www.texttoposter.com/*",
      "zone_name": "texttoposter.com"
    }
  ],
  "workers_dev": true,
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "cache": {
    "enabled": false
  },
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "RESPONSE_STORE",
      "service": "text-to-poster-response-store",
      "entrypoint": "ResponseStoreService"
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
