{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "text-to-poster-cron",
  "main": "src/index.js",
  "compatibility_date": "2026-09-20",
  // 与 vercel.json 里的 crons 一致：每天 03:00 维护、每周一 04:00 同步黑名单
  "triggers": {
    "crons": ["* * * * *", "0 3 * * *", "0 4 * * 1"]
  },
  "vars": {
    "APP_URL": "https://texttoposter.com"
  },
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
